#==============================================================================
# Sofy — environment configuration
#
# Copy to .env and adjust. Values here are the framework defaults; uncomment
# and change only what you need. `.env` is never committed.
#   cp .env.example .env && php sofy key:generate
#==============================================================================

#------------------------------------------------------------------------------
# Application
#------------------------------------------------------------------------------
APP_NAME=Sofy
APP_ENV=local                         # local | production
APP_DEBUG=true                        # true shows the debug error page; set false in production
APP_URL=http://localhost              # used for absolute URLs, CORS default and cookie Secure flag

# 32-byte base64 key for encryption / signed URLs. Generate with:
#   php sofy key:generate
APP_KEY=

#------------------------------------------------------------------------------
# Database
#------------------------------------------------------------------------------
DB_DRIVER=mysql                       # mysql | pgsql | sqlite
DB_HOST=127.0.0.1
DB_PORT=3306                          # mysql 3306 · pgsql 5432
DB_DATABASE=sofy                      # for sqlite: absolute path to the .db file
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

#------------------------------------------------------------------------------
# Cache
#------------------------------------------------------------------------------
CACHE_DRIVER=file                     # file | redis
CACHE_PREFIX=sofy_cache:

#------------------------------------------------------------------------------
# Session
#------------------------------------------------------------------------------
SESSION_DRIVER=file                   # file | redis
SESSION_LIFETIME=120                  # minutes
SESSION_COOKIE=sofy_session
SESSION_PREFIX=sofy_sess:             # redis key prefix (driver=redis)
# SESSION_REDIS_DB=                   # dedicated redis DB index for sessions (defaults to REDIS_DB)

#------------------------------------------------------------------------------
# Redis  (required when CACHE_DRIVER / SESSION_DRIVER / BROADCAST_DRIVER = redis)
#------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=2.0

#------------------------------------------------------------------------------
# Mail
#------------------------------------------------------------------------------
MAIL_HOST=127.0.0.1
MAIL_PORT=1025                        # e.g. Mailpit/Mailhog 1025 · real SMTP 587
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME=Sofy

#------------------------------------------------------------------------------
# Filesystem / S3
#------------------------------------------------------------------------------
FILESYSTEM_DISK=local                 # local | s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=                            # public base URL for stored files
# AWS_ENDPOINT=                       # custom endpoint (MinIO / R2 / DO Spaces)

#------------------------------------------------------------------------------
# Broadcasting & WebSocket
#------------------------------------------------------------------------------
BROADCAST_DRIVER=null                 # null | log | redis
WS_HOST=0.0.0.0                       # ws:serve bind address
WS_PORT=8080
# WS_HANDLER=                         # default handler FQCN for ws:serve (e.g. Messenger\WebSocket\ChatHandler)

#------------------------------------------------------------------------------
# CORS
#------------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=               # comma-separated; defaults to APP_URL. Use '*' only if you understand the implications
CORS_SUPPORTS_CREDENTIALS=false

#------------------------------------------------------------------------------
# Search engine
#------------------------------------------------------------------------------
SEARCH_DRIVER=database                # database (portable inverted index) | collection (in-memory)
SEARCH_INDEX_TABLE=search_index
SEARCH_STOPWORDS=en                   # en | ru (tokenizer stopword list)

#------------------------------------------------------------------------------
# UI asset compiler
#------------------------------------------------------------------------------
UI_INLINE=false                       # true = inline CSS/JS even when `php sofy ui:build` has compiled assets

#------------------------------------------------------------------------------
# Module marketplace
#------------------------------------------------------------------------------
# MARKETPLACE_CATALOG_URL=https://raw.githubusercontent.com/sofyphp/marketplace/main/modules.json
MARKETPLACE_RUN_MIGRATIONS=true       # run a module's migrations automatically on install

#------------------------------------------------------------------------------
# Messenger module  (admin user-to-user chat)
#------------------------------------------------------------------------------
# MESSENGER_WS_URL=                    # wss://host/ws — enables instant delivery; empty = polling only
MESSENGER_POLL_INTERVAL=4000          # ms between live-update polls
