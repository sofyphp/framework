{
    "name": "sofyphp/framework",
    "version": "0.4.10",
    "description": "Sofy \u2014 minimal PHP 8.3 MVC framework",
    "type": "project",
    "license": "MIT",
    "keywords": ["framework", "php", "mvc", "router", "orm", "no-dependencies"],
    "homepage": "https://github.com/sofyphp/framework",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "ext-simplexml": "*"
    },
    "autoload": {
        "psr-4": {
            "Sofy\\": "src/",
            "App\\": "app/",
            "Main\\": "Main/",
            "Blog\\": "modules/Blog/",
            "Demo\\": "modules/Demo/",
            "Orders\\": "modules/Orders/",
            "Shop\\": "modules/Shop/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "suggest": {
        "ext-redis": "Required for Redis cache and session drivers (CACHE_DRIVER=redis / SESSION_DRIVER=redis)",
        "ext-pcntl": "Required for graceful Ctrl+C shutdown of the WebSocket server (ws:serve)"
    },
    "minimum-stability": "stable"
}
